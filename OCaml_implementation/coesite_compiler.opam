opam-version: "2.0"
synopsis: "Compiles coesite"
description: "It compiles coesite."
maintainer: ["voir ci dessus"]
authors: ["Tectosilicate team"]
license: "LICENSE"
homepage: "https://github.com/maitrecraft1234/Coesite"
bug-reports: "https://github.com/maitrecraft1234/Coesite/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.13"}
  "dune-site"
  "pprint"
  "stdint"
  "sexplib"
  "menhir"
  "sedlex"
  "ppx_sexp_conv"
  "yojson"
  "pure-html"
  "domainslib"
  "re"
  "patdiff"
  "ppx_yojson_conv"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/maitrecraft1234/Coesite.git"
